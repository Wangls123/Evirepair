      "conflict_policy": {
        "energy_saving": {
          "decision": "allow",
          "expected_actions": [
            "climate.turn_off",
            "state.snapshot"
          ],
          "blocked_actions": [],
          "reason_code": "energy_saving"
        },
        "comfort_vs_energy": {
          "decision": "partial_allow",
          "expected_actions": [
            "notify.close_window"
          ],
          "blocked_actions": [
            "climate.turn_on"
          ],
          "reason_code": "comfort_vs_energy"
        }
