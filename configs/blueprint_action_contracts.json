    "scene_schedule": {
      "blueprint_id": "scene_schedule",
      "blueprint_type": "scene",
      "action_domains": [
        "scene",
        "schedule"
      ],
      "allowed_actions": [
        "scene.turn_on",
        "schedule.activate"
      ],
      "unsupported_actions": [
        "light.turn_on",
        "notify.mobile_app",
        "climate.turn_on",
        "alarm_control_panel.trigger"
      ],
      "gates": {
        "schedule_active": true,
        "manual_override": false
      },
      "conflict_policy": {
        "manual_override": {
          "decision": "partial_allow",
          "expected_actions": [
            "scene.turn_on"
          ],
          "blocked_actions": [
            "schedule.activate"
          ],
          "reason_code": "manual_scene_override"
        }
      },
      "registry_scene": "scene_schedule_override",
      "rule_source": "registry+template"
    },
